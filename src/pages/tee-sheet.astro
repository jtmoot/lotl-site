---
// Live tee sheet: who is signed up for each upcoming slot. Public by link,
// never indexed, never in the nav. Data comes from /api/tee-sheet (names only,
// no contact details) and is rendered client-side so the static shell stays
// cacheable while names never are.
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
---

<Layout
  title="Tee Sheet · Ladies on the Links"
  description="Who is signed up for each Monday tee time and lesson."
  noindex
>
  <PageIntro
    eyebrow="Who's playing"
    title="Tee sheet"
    lede="Names fill in automatically as bookings come through. Check back for the latest."
  />

  <section class="mx-auto max-w-4xl px-6 pb-24">
    <p
      class="mx-auto mb-6 max-w-2xl rounded-xl border border-forest/10 bg-cream-soft/60 px-5 py-3 text-center text-sm leading-relaxed text-slate"
      data-health
      aria-live="polite"
    >
      Checking sync status…
    </p>

    <div class="mb-8 flex flex-wrap items-center justify-center gap-3 print:hidden" data-controls>
      <nav aria-label="Range" class="flex rounded-full border border-forest/15 bg-cream-soft/70 p-1 text-sm">
        <a href="/tee-sheet" data-range="upcoming" class="rounded-full px-4 py-1.5 text-forest transition hover:bg-forest/5">Upcoming</a>
        <a href="/tee-sheet?range=past" data-range="past" class="rounded-full px-4 py-1.5 text-forest transition hover:bg-forest/5">Past 90 days</a>
      </nav>
      <button type="button" class="ghost-btn" data-print>Print</button>
    </div>

    <div class="mb-6 flex flex-wrap items-center justify-center gap-3 print:hidden" data-filters>
      <div role="group" aria-label="Event type" class="flex rounded-full border border-forest/15 bg-cream-soft/70 p-1 text-sm">
        <button type="button" data-type="all" class="rounded-full px-3 py-1.5 text-forest transition hover:bg-forest/5">All</button>
        <button type="button" data-type="tee_time" class="rounded-full px-3 py-1.5 text-forest transition hover:bg-forest/5">Tee times</button>
        <button type="button" data-type="lesson" class="rounded-full px-3 py-1.5 text-forest transition hover:bg-forest/5">Lessons</button>
        <button type="button" data-type="other" class="rounded-full px-3 py-1.5 text-forest transition hover:bg-forest/5">Other</button>
      </div>
      <label class="sr-only" for="tee-sheet-day">Day</label>
      <select id="tee-sheet-day" data-day-filter class="rounded-full border border-forest/15 bg-cream-soft/70 px-4 py-2 text-sm text-forest">
        <option value="">All days</option>
      </select>
      <label class="sr-only" for="tee-sheet-search">Search</label>
      <input
        id="tee-sheet-search"
        type="search"
        data-search
        placeholder="Search a name or event"
        autocomplete="off"
        class="w-56 rounded-full border border-forest/15 bg-cream-soft/70 px-4 py-2 text-sm text-ink placeholder:text-slate/70"
      />
      <button type="button" data-expand class="text-sm font-medium text-forest underline-offset-4 hover:underline">Expand all</button>
    </div>

    <div data-tee-sheet aria-live="polite" aria-busy="true">
      <p class="text-center text-slate">Loading the tee sheet…</p>
    </div>

  </section>
</Layout>

<style>
  [data-range][aria-current="true"],
  [data-type][aria-pressed="true"] {
    background: var(--color-forest);
    color: var(--color-cream);
  }
  details.day > summary {
    list-style: none;
    cursor: pointer;
  }
  details.day > summary::-webkit-details-marker {
    display: none;
  }
  details.day > summary .chev {
    transition: transform 0.15s ease;
  }
  details.day[open] > summary .chev {
    transform: rotate(90deg);
  }
  .day {
    break-inside: avoid;
  }
  @media print {
    :global(header),
    :global(footer),
    [data-controls] {
      display: none !important;
    }
    :global(body) {
      background: #fff;
      color: #000;
    }
    .day {
      page-break-inside: avoid;
    }
    table {
      font-size: 11pt;
    }
  }
</style>

<script>
  interface Slot {
    slotKey: string;
    date: string;
    time: string;
    title: string | null;
    kind: string | null;
    attendeeCount: number | null;
    attendeeLimit: number | null;
    eventCancelled: boolean;
    players: string[];
    cancelled: string[];
    countMismatch: boolean;
  }
  interface Health {
    lastEmailAt: string | null;
    emailsProcessed: number;
    emailLastError: string | null;
    emailLastErrorAt: string | null;
    apiLastOkAt: string | null;
    apiLastError: string | null;
    apiLastErrorAt: string | null;
    unparsedCount: number;
    unparsedLatestSubject: string | null;
    unparsedLatestAt: string | null;
    orphanSeatsHidden: number;
    countMismatchSlots: number;
  }
  interface Sheet {
    preset: 'upcoming' | 'past' | 'custom';
    range: { from: string; to: string };
    slots: Slot[];
    health: Health;
  }

  const root = document.querySelector<HTMLElement>('[data-tee-sheet]')!;
  const healthEl = document.querySelector<HTMLElement>('[data-health]')!;
  const params = new URLSearchParams(location.search);
  const daySelect = document.querySelector<HTMLSelectElement>('[data-day-filter]')!;
  const searchInput = document.querySelector<HTMLInputElement>('[data-search]')!;
  const expandBtn = document.querySelector<HTMLButtonElement>('[data-expand]')!;

  // Filters live in the URL so a filtered view can be shared or bookmarked.
  type TypeFilter = 'all' | 'tee_time' | 'lesson' | 'other';
  const filters = {
    type: ((['all', 'tee_time', 'lesson', 'other'] as TypeFilter[]).includes(params.get('type') as TypeFilter)
      ? params.get('type')
      : 'all') as TypeFilter,
    day: params.get('day') ?? '',
    q: params.get('q') ?? '',
  };
  let expandAll = false;
  let current: Sheet | null = null;

  function paintPills(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.type === filters.type));
    });
  }
  // Reflect URL filters before the data arrives so pills never flash from unpressed.
  paintPills();

  function syncUrl(): void {
    const u = new URL(location.href);
    for (const [k, v] of [['type', filters.type === 'all' ? '' : filters.type], ['day', filters.day], ['q', filters.q]]) {
      if (v) u.searchParams.set(k, v);
      else u.searchParams.delete(k);
    }
    history.replaceState(null, '', u);
  }
  function rerender(): void {
    if (current) render(current);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((b) =>
    b.addEventListener('click', () => {
      filters.type = b.dataset.type as TypeFilter;
      syncUrl();
      rerender();
    })
  );
  daySelect.addEventListener('change', () => {
    filters.day = daySelect.value;
    syncUrl();
    rerender();
  });
  searchInput.value = filters.q;
  searchInput.addEventListener('input', () => {
    filters.q = searchInput.value.trim();
    syncUrl();
    rerender();
  });
  expandBtn.addEventListener('click', () => {
    expandAll = !expandAll;
    rerender();
  });

  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
  // Closed <details> print nothing, so open everything for the printer and restore after.
  const wasOpen = new Map<Element, boolean>();
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLDetailsElement>('details.day').forEach((d) => {
      wasOpen.set(d, d.open);
      d.open = true;
    });
  });
  window.addEventListener('afterprint', () => {
    wasOpen.forEach((open, d) => ((d as HTMLDetailsElement).open = open));
    wasOpen.clear();
  });

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function longDate(date: string): string {
    return new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    });
  }
  function clock(hhmm: string): string {
    const [h, m] = hhmm.split(':').map(Number);
    const suffix = h >= 12 ? 'PM' : 'AM';
    const hour = h % 12 === 0 ? 12 : h % 12;
    return `${hour}:${String(m).padStart(2, '0')} ${suffix}`;
  }
  function ago(iso: string | null): string {
    if (!iso) return 'never';
    const mins = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (mins < 1) return 'just now';
    if (mins < 60) return `${mins} min ago`;
    const hrs = Math.round(mins / 60);
    if (hrs < 48) return `${hrs} hr ago`;
    return `${Math.round(hrs / 24)} days ago`;
  }
  function label(slot: Slot): string {
    if (slot.title) return slot.title;
    const type = slot.slotKey.split('|')[1] ?? '';
    if (type === 'tee_time') return 'Tee Time';
    if (type === 'oncourse_lesson') return 'On-Course Lesson';
    if (type === 'lesson') return 'Lesson';
    return type.replace(/^other:/, '').replace(/\b\w/g, (c) => c.toUpperCase()) || 'Booking';
  }
  function kindOf(slot: Slot): TypeFilter {
    if (slot.kind === 'tee_time' || slot.kind === 'lesson') return slot.kind;
    if (slot.kind === 'other') return 'other';
    const type = slot.slotKey.split('|')[1] ?? '';
    if (type === 'tee_time') return 'tee_time';
    if (type === 'lesson' || type === 'oncourse_lesson') return 'lesson';
    return 'other';
  }
  function matches(slot: Slot): boolean {
    if (filters.type !== 'all' && kindOf(slot) !== filters.type) return false;
    if (filters.day && slot.date !== filters.day) return false;
    if (filters.q) {
      const q = filters.q.toLowerCase();
      const hay = [label(slot), ...slot.players].join(' ').toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  }
  function openSpots(slot: Slot): string {
    if (slot.eventCancelled) return 'Cancelled';
    if (slot.attendeeLimit === null) return '';
    const open = Math.max(slot.attendeeLimit - (slot.attendeeCount ?? 0), 0);
    return open === 0 ? 'Full' : `${open} open`;
  }

  function render(sheet: Sheet): void {
    document.querySelectorAll<HTMLAnchorElement>('[data-range]').forEach((a) => {
      a.setAttribute('aria-current', String(a.dataset.range === sheet.preset));
    });

    current = sheet;

    // Day picker options follow the loaded range; keep the chosen day if it still exists.
    const days = [...new Set(sheet.slots.map((s) => s.date))];
    daySelect.innerHTML =
      '<option value="">All days</option>' +
      days.map((d) => `<option value="${esc(d)}"${d === filters.day ? ' selected' : ''}>${esc(longDate(d))}</option>`).join('');
    if (filters.day && !days.includes(filters.day)) daySelect.value = '';
    paintPills();
    expandBtn.textContent = expandAll ? 'Collapse all' : 'Expand all';

    if (sheet.slots.length === 0) {
      root.innerHTML = `<p class="text-center text-slate" data-empty>Nothing on the sheet for ${esc(sheet.range.from)} to ${esc(sheet.range.to)} yet.</p>`;
      return;
    }

    const shown = sheet.slots.filter(matches);
    if (shown.length === 0) {
      root.innerHTML = `<p class="text-center text-slate" data-no-match>No slots match these filters. <a href="${esc(location.pathname + (params.get('range') ? '?range=' + params.get('range') : ''))}" class="font-medium text-forest underline-offset-4 hover:underline">Clear filters</a></p>`;
      return;
    }

    const byDay = new Map<string, Slot[]>();
    for (const s of shown) byDay.set(s.date, [...(byDay.get(s.date) ?? []), s]);

    // Only the first day starts open, unless the reader is expanding or searching.
    const filtering = Boolean(filters.q || filters.day);
    root.innerHTML = [...byDay.entries()]
      .map(([date, slots], i) => {
        const players = slots.reduce((n, s) => n + s.players.length, 0);
        const open = expandAll || filtering || i === 0;
        return `
      <details class="day mb-4 rounded-xl border border-forest/10 bg-cream-soft/40" data-day="${esc(date)}"${open ? ' open' : ''}>
        <summary class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-5 py-4">
          <h2 class="font-serif text-2xl text-forest"><span class="chev mr-2 inline-block text-base text-slate">&#9656;</span>${esc(longDate(date))}</h2>
          <span class="text-sm text-slate" data-day-summary>${slots.length} slot${slots.length === 1 ? '' : 's'} &middot; ${players} player${players === 1 ? '' : 's'}</span>
        </summary>
        <div class="overflow-x-auto px-5 pb-4">
          <table class="w-full border-collapse text-left text-[0.95rem]">
            <thead>
              <tr class="border-b border-forest/15 text-xs uppercase tracking-wider text-slate">
                <th class="py-2 pr-4 font-medium">Time</th>
                <th class="py-2 pr-4 font-medium">Event</th>
                <th class="py-2 pr-4 font-medium">Players</th>
                <th class="py-2 font-medium">Spots</th>
              </tr>
            </thead>
            <tbody>
              ${slots
                .map(
                  (s) => `
              <tr class="border-b border-forest/10 align-top ${s.eventCancelled ? 'text-slate line-through' : ''}" data-slot="${esc(s.slotKey)}">
                <td class="whitespace-nowrap py-3 pr-4 font-medium text-forest">${esc(clock(s.time))}</td>
                <td class="py-3 pr-4">${esc(label(s))}${s.countMismatch ? ' <span class="text-rose" title="Bookwhen\'s count differs from the names listed">†</span>' : ''}</td>
                <td class="py-3 pr-4">${
                  s.players.length
                    ? `<ul class="space-y-0.5" data-players>${s.players.map((p) => `<li>${esc(p)}</li>`).join('')}</ul>`
                    : '<span class="text-slate/70">Open</span>'
                }</td>
                <td class="whitespace-nowrap py-3 text-slate">${esc(openSpots(s))}</td>
              </tr>`
                )
                .join('')}
            </tbody>
          </table>
        </div>
      </details>`;
      })
      .join('');
  }

  /** The cron fires on the quarter hour; count down to the next one. */
  function minutesToNextRefresh(now = new Date()): number {
    const past = now.getMinutes() % 15;
    const left = 15 - past;
    return now.getSeconds() > 0 && left === 15 ? 15 : left;
  }

  function renderHealth(h: Health): void {
    const parts: string[] = [];
    const n = minutesToNextRefresh();
    parts.push(`Events refresh in ${n} minute${n === 1 ? '' : 's'}.`);
    if (!h.apiLastOkAt) {
      parts.push('<span class="text-rose">Events have never been refreshed.</span>');
    } else if (Date.now() - new Date(h.apiLastOkAt).getTime() > 45 * 60000) {
      parts.push(
        `<span class="text-rose">Events last refreshed ${esc(ago(h.apiLastOkAt))}; the refresh may be stuck.</span>`
      );
    }
    if (h.apiLastError) {
      parts.push(
        `<span class="text-rose">Events refresh failing since ${esc(ago(h.apiLastErrorAt))}: ${esc(h.apiLastError)}</span>`
      );
    }
    if (h.emailLastError) {
      parts.push(
        `<span class="text-rose">Email storage error ${esc(ago(h.emailLastErrorAt))}: ${esc(h.emailLastError)}</span>`
      );
    }
    if (h.unparsedCount > 0) {
      parts.push(
        `<span class="text-rose">${h.unparsedCount} email${h.unparsedCount === 1 ? '' : 's'} could not be read in the last 30 days` +
          (h.unparsedLatestSubject ? ` (latest: “${esc(h.unparsedLatestSubject)}”)` : '') +
          '.</span>'
      );
    }
    if (h.countMismatchSlots > 0) {
      parts.push(
        `<span class="text-rose">Bookwhen's booking count differs from the names listed for ${h.countMismatchSlots} slot${h.countMismatchSlots === 1 ? '' : 's'} (marked †); a booking may have changed without an email.</span>`
      );
    }
    if (h.orphanSeatsHidden > 0) {
      parts.push(
        `${h.orphanSeatsHidden} booked name${h.orphanSeatsHidden === 1 ? ' is' : 's are'} hidden because the event no longer exists in Bookwhen.`
      );
    }
    healthEl.innerHTML = parts.join(' ');
  }

  async function load(): Promise<void> {
    const q = new URLSearchParams();
    for (const k of ['range', 'from', 'to']) {
      const v = params.get(k);
      if (v) q.set(k, v);
    }
    try {
      const res = await fetch(`/api/tee-sheet?${q}`, { cache: 'no-store' });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const sheet = (await res.json()) as Sheet;
      render(sheet);
      renderHealth(sheet.health);
    } catch (err) {
      root.innerHTML = `<p class="text-center text-rose" data-error>The tee sheet could not be loaded (${esc(String(err))}). Please try again in a minute.</p>`;
      healthEl.innerHTML = '<span class="text-rose">Sync status unavailable.</span>';
    } finally {
      root.removeAttribute('aria-busy');
    }
  }
  load();
</script>
